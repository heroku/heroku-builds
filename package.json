{
  "name": "@heroku-cli/heroku-builds",
  "version": "2.0.3",
  "description": "Heroku CLI plugin to list and create builds for Heroku apps",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/heroku/heroku-builds.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "keywords": [
    "heroku-plugin"
  ],
  "author": "Heroku",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/heroku/heroku-builds/issues"
  },
  "homepage": "https://github.com/heroku/heroku-builds",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "manifest": "oclif manifest",
    "readme": "oclif readme",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "test:watch": "mocha --parallel --watch --reporter dot \"test/**/*.test.ts\"",
    "test:coverage": "c8 --reporter=text-summary --reporter=lcovonly mocha --forbid-only \"test/**/*.test.ts\"",
    "docs:generate": "npm run build && npm run manifest && oclif readme --output-dir docs --multi",
    "prepare": "npm run build && npm run manifest",
    "postpack": "rimraf oclif.manifest.json"
  },
  "oclif": {
    "commands": "./dist/commands",
    "bin": "heroku",
    "devPlugins": [
      "@oclif/plugin-help"
    ]
  },
  "dependencies": {
    "@heroku-cli/command": "^13.0.0",
    "@heroku-cli/schema": "^2.0.1",
    "@heroku/heroku-cli-util": "^10.9.0",
    "@heroku/http-call": "^5.4.0",
    "@oclif/core": "^4.3.0",
    "ignore": "~ 5.3.1",
    "strftime": "0.10.3",
    "tar": "~7.5.4"
  },
  "devDependencies": {
    "@oclif/plugin-help": "^6",
    "@heroku-cli/test-utils": "^1.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "@types/strftime": "^0.9.8",
    "c8": "^10.1.3",
    "chai": "^6.2.2",
    "eslint": "^10",
    "eslint-plugin-mocha": "^11.2.0",
    "mocha": "^11",
    "nock": "^14",
    "oclif": "4.23.30",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "oclif.manifest.json",
    "/dist"
  ],
  "//overrides": "serialize-javascript: mocha transitive dep, pinned for CVE-2024-11831",
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
